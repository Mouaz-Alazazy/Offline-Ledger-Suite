{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "منظومة حساب",
  "version": "1.0.0",
  "identifier": "org.hisab.accounting",
  "build": {
    "beforeDevCommand": "pnpm run dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:web",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "title": "منظومة حساب",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "نظام محاسبي يعمل دون اتصال بالإنترنت",
    "longDescription": "نظام حسابات محلي لإدارة الإيرادات والمصروفات والدفتر المحاسبي والفواتير.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:hisab.db"]
    }
  }
}
